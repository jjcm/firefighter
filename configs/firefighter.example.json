{
  "state_dir": "/var/lib/firefighter",
  "observe": false,
  "require_root": true,
  "tick_seconds": 15,
  "inventory_seconds": 1800,
  "recheck_seconds": 900,
  "max_incidents_per_tick": 4,
  "max_rounds": 8,
  "max_actions_per_round": 6,
  "command_timeout_seconds": 300,
  "incident_timeout_seconds": 1800,
  "max_output_bytes": 32768,
  "max_pending_incidents": 10000,
  "record_retention_days": 30,
  "instructions": "Protect this Linux host and its locally deployed applications. Use installed scanners when available. Prioritize actively exploited and internet-exposed software. Apply fixes and verify service health. Maintain access needed for recovery. If compromise is suspected, preserve evidence and assess persistence before rotating affected credentials using configured hooks. Never infer absence of compromise from a clean vulnerability scan.",
  "rotation_hooks": {},
  "llm": {
    "backend": "api",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-6.1-sol",
    "api_key_env": "OPENAI_API_KEY",
    "command": null,
    "dir": "",
    "timeout_seconds": 120,
    "json_mode": false
  },
  "sources": [
    {
      "name": "ubuntu-usn",
      "type": "rss",
      "url": "https://ubuntu.com/security/notices/rss.xml",
      "interval_seconds": 120,
      "lookback_hours": 0,
      "trust": "official"
    },
    {
      "name": "cisa-kev",
      "type": "kev",
      "interval_seconds": 300,
      "lookback_hours": 0
    },
    {
      "name": "nvd",
      "type": "nvd",
      "interval_seconds": 300,
      "lookback_hours": 24,
      "token_env": "NVD_API_KEY"
    },
    {
      "name": "x",
      "type": "x",
      "interval_seconds": 60,
      "lookback_hours": 1,
      "token_env": "X_BEARER_TOKEN",
      "query": "(CVE OR \"zero day\" OR \"zero-day\" OR \"security advisory\" OR RCE) -is:retweet"
    }
  ],
  "report": {
    "url": "",
    "secret_env": "FIREFIGHTER_REPORT_SECRET",
    "bearer_token_env": ""
  }
}
